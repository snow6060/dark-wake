# Copy this file to .env and adjust as needed.

# SQLite path for Phase 1. Swap to a Postgres DSN later, e.g.
# postgresql+psycopg2://user:pass@localhost:5432/darkwake
DATABASE_URL=sqlite:///data/darkwake.db

# IMF PortWatch ArcGIS FeatureServer (Daily_Chokepoints_Data, layer 0)
PORTWATCH_FEATURE_SERVER_URL=https://services9.arcgis.com/weJ1QsnbMYJlCHdG/ArcGIS/rest/services/Daily_Chokepoints_Data/FeatureServer/0/query

# How many days of history to pull per ingest run
PORTWATCH_LOOKBACK_DAYS=120

# Hourly is overkill for a dataset that refreshes weekly, but cheap and
# guarantees we pick up new rows soon after PortWatch publishes them.
INGEST_INTERVAL_HOURS=1

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Phase 2 — LLM API keys (one of these is required for /api/analyze)
# ---------------------------------------------------------------------------

# Option A: plain OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_NAME=gpt-4o-mini   # default if not set

# Option B: OpenRouter (supports many models via one key)
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_MODEL_NAME=anthropic/claude-3.5-sonnet  # or any OpenRouter model slug

# Option C: any OpenAI-compatible endpoint
# OPENAI_API_KEY=...
# OPENAI_API_BASE=https://your-endpoint/v1
# OPENAI_MODEL_NAME=your-model
